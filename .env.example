# Server Port
PORT=3000

# Infobip SMS & Omnichannel API (Server-side & Cloud)
INFOBIP_BASE_URL=m9kvm2.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_SENDER_ID=AURA

# Super Admin Credential (Server-side verification)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Exchange Rate (USD to LRD)
USD_TO_LRD_RATE=195

# Google Maps API Key (Optional frontend map rendering)
VITE_GOOGLE_MAPS_API_KEY=

# Public Firebase client configuration (never put Admin SDK JSON here)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=auraliberia
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=aura-shared
VITE_COMMAND_API_BASE_URL=

# Public browser push key (all private messaging credentials stay on the backend)
VITE_FIREBASE_VAPID_KEY=
